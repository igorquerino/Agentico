@* O card da carteira do Start (mock "Foco"): fala a língua do Panorama (etiqueta e halo da gravidade, a frase
   curta do alerta) e o botão diz a AÇÃO que resolve, não "abrir". Quem está em automação ganha o feixe de luz;
   quem parou, o feixe vermelho parado. O Start abre o painel aqui mesmo, sem mudar de tela. *@
<article class="cc @(Principal is { } p0 ? "g" + (int)p0.Gravidade : "") @(painel ? "open" : "")" @onclick="AbrirCliente" tabindex="0" @onkeydown="TeclaAbrir" aria-label="@($"{Cliente.Nome}: {Estagios.Descricao(Estagio).Titulo}")">
    @if (Principal is { } a)
    {
        <span class="tag g@((int)a.Gravidade)"><span class="n">@((int)a.Gravidade)</span>@Gravidades.Rotulo(a.Gravidade)</span>
        <span class="when">@Quando(a)</span>
    }
    else if (DecisoesPendentes > 0)
    {
        <span class="tag aqua"><span class="n">@DecisoesPendentes</span>decisões</span>
    }
    <div class="aura @(Ligada ? "on" : "") @(Auto.EmCurso ? "rapida" : "") @(Principal?.Gravidade == Gravidade.AutomacaoParou ? "parou" : "")">
        <span class="clogo">
            @if (Cliente.Assets.FirstOrDefault(x => x.Tipo == TipoDeAsset.LogoPrincipal && x.Url is not null) is { } logo) { <img src="@logo.Url" alt="" /> }
            else { <span>@Iniciais(Cliente.Nome)</span> }
        </span>
    </div>
    <h3>@Cliente.Nome</h3>
    <div class="meta">@(Cliente.Squads.Count > 0 ? string.Join(" + ", Cliente.Squads) : Cliente.Squad) · @Cliente.Status.Replace('_', ' ') · @(Estagios.CampanhaPublicada(Cliente) ? "Automação" : Estagios.Descricao(Estagio).Curto) · @(Cliente.BudgetMensal is > 0 ? Dinheiro.ReaisRedondos(Dinheiro.CentavosDe(Cliente.BudgetMensal.Value)) + "/mês" : "desde " + Cliente.Desde.ToString("dd/MM"))</div>
    @if (Auto.EmCurso)
    {
        <div class="al"><i style="background:var(--aqua);box-shadow:0 0 10px var(--aqua)"></i>&#8635; @Auto.Mensagem</div>
    }
    else if (Auto.Parou)
    {
        <div class="al"><i style="background:var(--g4);box-shadow:0 0 10px var(--g4)"></i>@Auto.Mensagem</div>
    }
    else if (Principal is { } al)
    {
        <div class="al"><i style="background:@Gravidades.De(al.Gravidade).Cor;box-shadow:0 0 10px @Gravidades.De(al.Gravidade).Cor"></i>@al.Curto</div>
    }
    else if (DecisoesPendentes > 0)
    {
        <div class="al"><i style="background:var(--aqua);box-shadow:0 0 10px var(--aqua)"></i>@DecisoesPendentes decisão(ões) do agente esperando você</div>
    }
    <div class="fl">
        @if (Acao.Resolve is not null) { <text>o que resolve: <b>@Acao.Resolve</b></text> }
        else if (Pendencias.Count > 0) { <text>falta: <b>@string.Join(", ", Pendencias.Take(3))@(Pendencias.Count > 3 ? $" e mais {Pendencias.Count - 3}" : "")</b></text> }
    </div>
    <div class="mt7" aria-hidden="true">
        @foreach (var d in Estagios.Lista) { <i class="@(d.Estagio < Estagio ? "d" : d.Estagio == Estagio ? "a" : "")"></i> }
    </div>
    @if (painel)
    {
        <PainelStart Cliente="Cliente" Api="Api" IniciarStart="Disparar" Fechar="() => painel = false" />
    }
    else
    {
        <div class="act" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            @if (Auto.EmCurso)
            {
                <span class="pill ok"><i></i>Start em curso</span>
            }
            else if (Acao.Etapa == Estagio.Chegada && Estagio == Estagio.Chegada)
            {
                <button type="button" class="btn-p big" @onclick="() => painel = true" title="o agente preenche o que falta e liga a automação">&#9654; Start</button>
            }
            else
            {
                <button type="button" class="btn-p" @onclick="() => AbrirEtapa.InvokeAsync((Cliente, Acao.Etapa))">@Acao.Rotulo</button>
                @if (Estagios.CampanhaPublicada(Cliente)) { <span class="pill ok"><i></i>agente: @Condutor.Rotulo(Cliente.Modo)</span> }
                else { <a href="" @onclick="AbrirCliente" @onclick:preventDefault="true">abrir o cliente</a> }
            }
            @if (Auto.Trilha.Count > 0)
            {
                <a href="" @onclick="() => trilha = !trilha" @onclick:preventDefault="true">@(trilha ? "esconder" : "ver") a trilha</a>
            }
        </div>
        @if (trilha && Auto.Trilha.Count > 0)
        {
            <ol class="trilha-start mini text-3" @onclick:stopPropagation="true">
                @foreach (var t in Auto.Trilha) { <li>@t</li> }
            </ol>
        }
    }
</article>

@code {
    [Parameter] public required Cliente Cliente { get; set; }
    [Parameter] public required IBlueApi Api { get; set; }
    [Parameter] public Estagio Estagio { get; set; }
    [Parameter] public List<string> Pendencias { get; set; } = new();
    [Parameter] public IReadOnlyList<Alerta> Alertas { get; set; } = [];
    [Parameter] public int DecisoesPendentes { get; set; }
    [Parameter] public EventCallback<Cliente> Abrir { get; set; }
    [Parameter] public EventCallback<(Cliente Cliente, Estagio Etapa)> AbrirEtapa { get; set; }
    [Parameter] public EventCallback<PedidoDeStart> IniciarStart { get; set; }

    bool painel; bool trilha;
    EstadoDaAutomacao Auto => Cliente.Automacao;
    Alerta? Principal => Alertas.FirstOrDefault();
    AcaoDoCard Acao => AcoesDoCard.De(Cliente, Estagio, Principal, DecisoesPendentes);
    bool Ligada => Estagios.CampanhaPublicada(Cliente) || Auto.EmCurso || Auto.Pronto;

    static string Iniciais(string nome) => string.Concat(nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    static string Quando(Alerta a)
    {
        if (a.Desde is not { } d) return "";
        var dias = (DateTime.Now.Date - d.Date).Days;
        return dias switch { 0 => $"hoje {d:HH:mm}", 1 => $"ontem {d:HH:mm}", _ => $"{dias} d" };
    }
    Task AbrirCliente() => painel ? Task.CompletedTask : Abrir.InvokeAsync(Cliente);
    Task TeclaAbrir(KeyboardEventArgs e) => !painel && e.Key is "Enter" or " " ? Abrir.InvokeAsync(Cliente) : Task.CompletedTask;

    async Task Disparar(PedidoDeStart pedido)
    {
        painel = false; trilha = false;
        await IniciarStart.InvokeAsync(pedido);
    }
}
