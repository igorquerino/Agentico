@* O agente gera as artes das peças aprovadas; o gestor escolhe o criativo piloto do Start. *@
@{
    var aprovadas = Cliente.Pecas.Where(p => p.Aprovada && p.CrivoOk).ToList();
}
<div class="grade-2">
    <div class="caixa">
        <h3>Peças aprovadas</h3>
        @if (aprovadas.Count == 0) { <p class="text-3">Nenhuma peça aprovada ainda: volte à etapa Copy.</p> }
        <ul class="lista-simples">
            @foreach (var p in aprovadas)
            {
                <li><label class="opcao"><input type="checkbox" checked="@escolhidas.Contains(p.Id)" @onchange="e => Marcar(p.Id, e)" /> <span class="pilula pilula-etapa">@p.Etapa</span> <span>@p.Headline</span></label></li>
            }
        </ul>
        <div class="formatos">
            <label class="opcao"><input type="checkbox" @bind="feed" /> feed 1080x1080</label>
            <label class="opcao"><input type="checkbox" @bind="story" /> story 1080x1920</label>
        </div>
        <div class="acoes">
            <button type="button" class="btn btn-destaque" @onclick="Gerar" disabled="@(ocupado || escolhidas.Count == 0 || (!feed && !story))">@(ocupado ? (Api.EhDemo ? "Gerando…" : "Gerando… de 1 a 3 min por arte") : $"Gerar {escolhidas.Count * ((feed ? 1 : 0) + (story ? 1 : 0))} arte(s)")</button>
        </div>
        <p class="text-3 mini">@(Api.EhDemo ? "Demonstração: a arte é diagramada em SVG (HEAD, SUB, CTA e marca). Nas fontes reais a imagem sai do Agente Designer." : "O Agente Designer do V1 desenha cada arte com o modelo de imagem (gpt-image) a partir da copy escolhida, uma chamada por arte e formato. Cada arte entra na galeria assim que fica pronta; as já existentes vêm da biblioteca do Designer.")</p>
    </div>
    <div class="caixa">
        <h3>Criativos piloto</h3>
        <p class="text-3 mini">Um criativo por etapa do funil, como a faixa do budget pede (@string.Join(", ", Exigidas)). Cada conjunto do Start leva o piloto da etapa dele (1 anúncio por conjunto, AD-MT-17). Trocar o criativo depois é decisão do motor, pela árvore.</p>
        <div class="pilotos">
            @foreach (var et in Exigidas)
            {
                <div class="piloto-slot @(Cliente.PilotoDa(et) is null ? "vazio" : "")">
                    <span class="pilula pilula-etapa">@et</span>
                    @if (Cliente.PilotoDa(et) is { } pl)
                    {
                        var vaga = Assentos.First(x => x.Vaga == et);
                        <img class="piloto" src="@pl.Url" alt="@pl.Titulo" />
                        <p class="mini">@pl.Titulo</p>
                        <p class="mini @(vaga.Ok ? "ok" : "erro")">@(vaga.Ok ? "✓ " : "✗ ")@vaga.Motivo</p>
                        <button type="button" class="btn btn-ghost btn-mini" @onclick="() => Piloto(et, null)">tirar</button>
                    }
                    else { <p class="warn mini">sem piloto de @et: escolha uma arte na galeria</p> }
                </div>
            }
        </div>
    </div>
</div>

@if (erro is not null) { <p class="erro" role="alert">@erro</p> }

<div class="galeria">
    @foreach (var a in Cliente.Artes)
    {
        <figure class="arte @(a.Aprovada ? "aprovada" : "") @(Cliente.Pilotos.ContainsValue(a.Id) ? "piloto" : "")">
            <img src="@a.Url" alt="@a.Titulo" loading="lazy" />
            <figcaption>
                <div class="mini"><span class="pilula pilula-etapa">@a.Etapa</span> @a.Titulo</div>
                <div class="acoes">
                    <button type="button" class="btn btn-mini @(a.Aprovada ? "btn-ghost" : "btn-destaque")" @onclick="() => Aprovar(a)">@(a.Aprovada ? "Desaprovar" : "Aprovar")</button>
                    @foreach (var et in Exigidas)
                    {
                        var ehPiloto = Cliente.Pilotos.TryGetValue(et, out var pid) && pid == a.Id;
                        var etapaDaArte = Cliente.Pecas.FirstOrDefault(p => p.Id == a.PecaId)?.Etapa ?? a.Etapa;
                        var assentoCerto = etapaDaArte == et;
                        <button type="button" class="btn btn-mini @(ehPiloto ? (assentoCerto ? "btn-ok" : "btn-erro") : "btn-ghost") @(assentoCerto ? "" : "assento-fora")" title="@(assentoCerto ? $"usar como piloto de {et}" : $"assento errado: esta arte nasceu da copy de {etapaDaArte}; o validador recusa o Publicar com ela na vaga de {et}")" @onclick="() => Piloto(et, ehPiloto ? null : a.Id)">@(ehPiloto ? $"piloto {et}" : $"piloto de {et}")@(assentoCerto ? "" : " ⚠")</button>
                    }
                </div>
            </figcaption>
        </figure>
    }
</div>

<footer class="etapa-rodape">
    @{ var (ok, pend) = Estagios.DesignPronto(Cliente, Api.Parametros); }
    @if (ok) { <span class="ok">Criativo piloto escolhido.</span> } else { <span class="warn">Falta: @string.Join(", ", pend).</span> }
    <button type="button" class="btn btn-destaque" @onclick="() => Avancar.InvokeAsync()">Ir para a campanha &rarr;</button>
</footer>

@code {
    [Parameter] public required Cliente Cliente { get; set; }
    [Parameter] public required IBlueApi Api { get; set; }
    [Parameter] public EventCallback Avancar { get; set; }

    HashSet<string> escolhidas = new();
    bool feed = true, story = true;
    string? erro; bool ocupado;
    Cliente? visto;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(visto, Cliente)) return;
        visto = Cliente;
        escolhidas = Cliente.Pecas.Where(p => p.Aprovada && p.CrivoOk).Take(3).Select(p => p.Id).ToHashSet();
    }

    void Marcar(string id, ChangeEventArgs e) { if (e.Value is true) escolhidas.Add(id); else escolhidas.Remove(id); }

    async Task Gerar()
    {
        erro = null; ocupado = true;
        try
        {
            var formatos = new List<string>(); if (feed) formatos.Add("feed"); if (story) formatos.Add("story");
            await Api.GerarArtesAsync(Cliente, escolhidas.ToList(), formatos);
        }
        catch (Exception ex) { erro = ex.Message; }
        finally { ocupado = false; }
    }

    async Task Aprovar(Arte a) { erro = null; try { await Api.AprovarArteAsync(Cliente, a.Id, !a.Aprovada); } catch (Exception ex) { erro = ex.Message; } }
    /// <summary>As etapas que a faixa do budget pede: uma vaga de piloto para cada.</summary>
    IReadOnlyList<Etapa> Exigidas => Estagios.EtapasExigidas(Cliente, Api.Parametros);
    /// <summary>O validador de assento: cada vaga com a arte dela e o veredito (copy da etapa certa ou não).</summary>
    List<AssentoDoPiloto> Assentos => Estagios.ValidarAssentos(Cliente, Api.Parametros);
    async Task Piloto(Etapa etapa, string? arteId) { erro = null; try { await Api.EscolherPilotoAsync(Cliente, etapa, arteId); } catch (Exception ex) { erro = ex.Message; } }
}
