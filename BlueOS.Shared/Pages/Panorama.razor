@page "/"
@inject FonteDeDados Fonte
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Blue OS · Panorama</PageTitle>

@* O MAPA ESTELAR DO SQUAD. Cada cliente é uma estrela do mesmo tamanho; só a cor fala. A gravidade puxa para o
   centro: anel 1 (automação parou, dinheiro), anel 2 (churn, travado), anel 3 (pedido, frio); os em dia orbitam
   quietos na borda, em ordem alfabética a partir do topo. No centro, o placar vivo de saúde do squad. Clicar abre
   o aprofundamento preso à estrela; resolver acende a estrela em verde e ela desliza pra órbita de fora. *@
@if (Painel.Erro is not null && pan is null)
{
    <div class="vazio"><div><p class="erro">@Painel.Erro</p><p class="text-3">Troque a fonte de dados no botão do squad, no topo.</p></div></div>
}
else
{
    var p = pan;
    var resumo = p?.Resumo;
    var placar = p?.Placar;
    var achados = Painel.Achadas().Select(e => e.Slug).ToHashSet();
    var buscando = Painel.Busca.Length > 0;
    /* sem nenhum KPI lido (V1 e API sem a Meta), o resumo diz "—" em vez de "R$ 0 de R$ X" e "0 de 0 MQL" */
    var temKpis = p is not null && p.Estrelas.Any(e => e.Cliente.Sinais.Kpis is not null);
    var comPontos = placar is { GestoresNoSquad: > 0 };
    <section class="lay" @onclick="FecharPopover">
        <aside class="left">
            <div class="greet">
                <h1>@Saudacao, <b>@(placar?.Gestor ?? "gestor")</b>.</h1>
                @if (resumo is null) { <p>Lendo a carteira do squad…</p> }
                else if (resumo.Clientes == 0) { <p>Nenhum cliente neste squad.</p> }
                else if (resumo.PrecisamDeVoce == 0 && resumo.EmDia == resumo.Clientes) { <p>Os <b class="ok">@resumo.Clientes</b> orbitam em dia. Nada precisa de você agora.</p> }
                else if (resumo.PrecisamDeVoce == 0) { <p>Nada precisa de você agora. <b class="ok">@resumo.EmDia</b> dos <b>@resumo.Clientes</b> orbitam em dia.</p> }
                else { <p><b class="att">@resumo.PrecisamDeVoce</b> dos <b>@resumo.Clientes</b> precisam de você. <b class="ok">@resumo.EmDia</b> orbitam em dia.</p> }
                <div class="meta">@Agora.ToString("dddd, d 'de' MMMM", Pt) · @Agora.ToString("HH:mm") · dia @Agora.Day de @DateTime.DaysInMonth(Agora.Year, Agora.Month)</div>
            </div>
            <div class="card">
                <h3>Squad @(p?.Squad ?? "") <small>@(resumo?.Clientes ?? 0) clientes</small></h3>
                @if (p is not null && p.Squads.Count > 1 && !string.Equals(Fonte.Config.SquadPadrao, p.Squad, StringComparison.OrdinalIgnoreCase))
                {
                    <p class="text-3 mini">@(Fonte.Config.SquadPadrao is null ? "sem squad escolhido" : $"o squad {Fonte.Config.SquadPadrao} não está nesta carteira"): este é o 1º em ordem alfabética. Escolha o squad nos chips do Start.</p>
                }
                @if (resumo is not null)
                {
                    <div class="sum">
                        <div class="r"><span>em automação</span><b class="ok">@resumo.EmAutomacao</b></div>
                        <div class="r"><span>precisam de você</span><b class="@(resumo.PrecisamDeVoce > 0 ? "att" : "ok")">@resumo.PrecisamDeVoce</b></div>
                        <div class="r"><span>gasto do mês</span><b>@(temKpis ? Curto(resumo.GastoCentavos) : "—") @if (temKpis) { <small>de @Curto(resumo.BudgetCentavos)</small> }</b></div>
                        <div class="bar"><i style="width:@(temKpis ? Pct(resumo.GastoCentavos, resumo.BudgetCentavos) : 0)%"></i></div>
                        <div class="r"><span>MQL vs meta</span><b>@(temKpis ? resumo.Mql.ToString() : "—") @if (temKpis) { <small>de @resumo.MetaMql</small> }</b></div>
                        <div class="bar aqua"><i style="width:@(temKpis ? Pct(resumo.Mql, resumo.MetaMql) : 0)%"></i></div>
                        <div class="r"><span>R$ por MQL</span><b>@(resumo.CustoMedioPorMqlCentavos is { } c ? (c / 100).ToString() : "—") <small>teto médio @(resumo.TetoMedioCentavos is { } t ? (t / 100).ToString() : "—")</small></b></div>
                    </div>
                }
            </div>
            <div class="card stamps @(Painel.Erro is not null ? "parado" : "")">
                <h3>Sinais de vida @if (Painel.Erro is not null) { <small style="color:var(--g3)">@Vida.SemLeitura(Painel.LidoEm, DateTime.Now)</small> } else { <small style="color:var(--aqua)">@(Painel.Lendo ? "lendo…" : "vigiando agora")</small> }</h3>
                @if (p is not null) { foreach (var s in p.SinaisDeVida) { <div class="@(s.Ruim ? "bad" : !s.Vigiado ? "nao-vigiado" : "")"><span>@s.Fonte</span><b>@s.Texto</b></div> } }
            </div>
        </aside>

        <section class="orbit">
            <div class="map @(buscando ? "busca" : "") @(resumo is { PrecisamDeVoce: 0 } ? "calmo" : "") @(p is null ? "skeleton" : "")" style="--saude:@(resumo?.SaudePct ?? 0)%">
                <div class="ring r4"><em>@(resumo is null ? "" : resumo.Clientes == 0 ? "nenhum cliente neste squad" : $"{resumo.EmDia} em dia · orbitam quietos")</em></div>
                <div class="ring r3"><em>5–6</em></div>
                <div class="ring r2"><em>3–4</em></div>
                <div class="ring r1"><em>1–2</em></div>
                <div class="hub"><div class="in">
                    <span class="l">Saúde do squad</span>
                    <span class="v @(saudeSobe ? "sobe" : "")" aria-live="polite">@(resumo?.SaudePct is { } saude ? $"{saude}%" : "—")</span>
                    <span class="d">@(resumo is null ? "" : $"{resumo.EmDia} de {resumo.Clientes} em dia")@(placar is { SaudeOntemPct: > 0 } pl ? $" · {(resumo!.SaudePct >= pl.SaudeOntemPct ? "↑" : "↓")} ontem {pl.SaudeOntemPct}" : "")</span>
                    <span class="d2">@(placar is null ? "" : $"{placar.DiasSemVermelho} d sem vermelho · recorde {placar.RecordeSemVermelho}")</span>
                </div></div>
                @if (p is not null)
                {
                    @* Leitor de tela: o mapa é uma lista de estrelas, na ordem de atenção (gravidade, depois os em dia em ordem alfabética), e todas entram no Tab. *@
                    <div class="estrelas" role="list" aria-label="@($"Clientes do squad {p.Squad}")">
                    @foreach (var e in p.Estrelas)
                    {
                        var a = e.Principal;
                        var acendendo = acendem.ContainsKey(e.Slug);
                        var classe = $"s {(a is null ? "ok" : "g" + (int)a.Gravidade)} {(Math.Cos(e.Posicao.Angulo * Math.PI / 180) < 0 ? "l" : "")} {(e.EstaVista ? "visto" : "")} {(Painel.Foco == e.Slug ? "aberta" : "")} {(buscando && achados.Contains(e.Slug) ? "hit" : "")} {(acendendo ? "acende" : "")}";
                        <div class="estrela" role="listitem" @key="e.Slug">
                        <button type="button" class="@classe" style="@EstiloDa(e)" title="@e.Nome" aria-label="@RotuloDaEstrela(e)" tabindex="0" @onclick="() => Abrir(e)" @onclick:stopPropagation="true" @onkeydown="k => Tecla(k, e)">
                            <b>
                                @if (a is not null) { <em class="g@((int)a.Gravidade)">@((int)a.Gravidade)</em> }
                                @e.Nome<small>@(a is null ? (e.DecisoesPendentes > 0 ? $"em dia · {e.DecisoesPendentes} decisão(ões) do agente esperando você" : "em dia") : e.EstaVista ? $"{a.Curto} · visto às {e.Visto!.Em:HH:mm}" : a.Curto)</small>
                            </b>
                        </button>
                        @if (acendendo && comPontos) { <span class="chip-pts" style="@ChipDa(e)">+@acendem[e.Slug] pts</span> }
                        </div>
                    }
                    </div>
                    @if (Painel.Foco is { } foco && p.Estrelas.FirstOrDefault(x => x.Slug == foco) is { } aberta)
                    {
                        <Aprofundamento Estrela="aberta" Api="Fonte.Atual" Fechar="FecharPopover" Aviso="Avisar" />
                    }
                }
            </div>
        </section>

        <aside class="right">
            <div class="card">
                <h3>Seus pontos <small>@Agora.ToString("MMMM", Pt)</small></h3>
                <div class="pts">@((placar?.Pontos ?? 0).ToString("N0", Pt))<small>pts</small></div>
                @if (placar is { GestoresNoSquad: > 0 }) { <div class="pos"><b>@(placar.PosicaoNoSquad)º</b> no @p!.Squad · @(placar.PosicaoGeral)º entre @placar.GestoresNoTotal gestores</div> }
                else { <div class="pos text-3">pontos e ranking chegam com a rota do Panorama na API</div> }
                @if (placar is { } pc && pc.ACaminhoOuVazio.Count > 0)
                {
                    foreach (var ac in pc.ACaminhoOuVazio.Take(4)) { <div class="acaminho"><span><b>+@ac.Pontos pts</b> a caminho · @ac.Cliente</span><span title="@ac.Por">@(ac.Quando.Date == Agora.Date ? ac.Quando.ToString("HH:mm") : ac.Quando.ToString("dd/MM"))</span></div> }
                }
                @if (placar is { Gestores.Count: > 0 })
                {
                    <ol class="rank">@foreach (var (g, i) in placar.Gestores.Select((g, i) => (g, i))) { <li class="@(g.EhVoce ? "me" : "")"><span>@(i + 1)</span>@g.Nome<b>@g.Valor.ToString("N0", Pt)</b></li> }</ol>
                }
                @if (placar is { Squads.Count: > 0 })
                {
                    <h3 style="margin-top:12px">Squads <small>saúde hoje</small></h3>
                    <ol class="rank">@foreach (var (s, i) in placar.Squads.Select((s, i) => (s, i))) { <li class="@(s.EhVoce ? "me" : "")"><span>@(i + 1)</span>@s.Nome<b>@s.Valor%</b></li> }</ol>
                }
            </div>
            <div class="card feed">
                <h3>Acendeu hoje</h3>
                @if (placar is null || placar.AcendeuHoje.Count == 0) { <div class="text-3">ninguém acendeu ainda hoje</div> }
                else { foreach (var ac in placar.AcendeuHoje) { <div><time>@(ac.Quando.Date == Agora.Date ? ac.Quando.ToString("HH:mm") : ac.Quando.Date == Agora.Date.AddDays(-1) ? "ontem" : ac.Quando.ToString("dd/MM"))</time><b>@ac.Cliente</b><em>+@ac.Pontos · @(ac.Por == placar.Gestor ? "você" : ac.Por)</em></div> } }
            </div>
        </aside>
    </section>
}

@if (toast is not null)
{
    @* toast é HTML: tudo o que vem de fora (nome do cliente, mensagem de erro) entra codificado em AvisarHtml/Avisar *@
    <div class="toast @(toastNeutro ? "neutro" : "")"><i>@(toastNeutro ? "·" : "✓")</i><span>@((MarkupString)toast)</span></div>
}

@code {
    [CascadingParameter] public required Painel Painel { get; set; }
    static readonly System.Globalization.CultureInfo Pt = new("pt-BR");

    PanoramaDoSquad? pan;
    DateTime Agora => pan?.Agora ?? DateTime.Now;
    readonly Dictionary<string, Gravidade> anterior = new();
    readonly Dictionary<string, int> acendem = new();
    int? saudeAnterior; bool saudeSobe;
    string? toast; bool toastNeutro;
    CancellationTokenSource? toastCts;

    string Saudacao => Agora.Hour is >= 5 and < 12 ? "Bom dia" : Agora.Hour is >= 12 and < 18 ? "Boa tarde" : "Boa noite";

    protected override void OnInitialized()
    {
        /* Deep link antigo: /?cliente=<slug>&etapa=... continua valendo e cai no Start. */
        var q = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        if (!string.IsNullOrWhiteSpace(q["cliente"])) { Nav.NavigateTo("start" + new Uri(Nav.Uri).Query, replace: true); return; }
        /* /?foco=<slug> abre a estrela já com o aprofundamento (o sino e a faixa chegam por aqui). */
        if (!string.IsNullOrWhiteSpace(q["foco"])) Painel.Foco = q["foco"];
        Painel.Mudou += Mudou;
        Absorver(Painel.Panorama);
    }

    void Mudou() => InvokeAsync(() => { Absorver(Painel.Panorama); StateHasChanged(); });

    /* Compara com a leitura anterior: alerta que sumiu = estrela acendeu (animação + chip de pontos + placar subindo). */
    void Absorver(PanoramaDoSquad? novo)
    {
        if (novo is null)
        {
            /* a fonte mudou (Painel.Limpar): o mapa e a memória do "acendeu" da fonte anterior não ficam na tela */
            pan = null; anterior.Clear(); acendem.Clear(); saudeAnterior = null; saudeSobe = false;
            return;
        }
        if (ReferenceEquals(novo, pan)) return;
        var acesas = new List<(string Slug, Gravidade G)>();
        foreach (var e in novo.Estrelas)
        {
            if (e.Principal is { } a) anterior[e.Slug] = a.Gravidade;
            else if (anterior.Remove(e.Slug, out var g)) acesas.Add((e.Slug, g));
        }
        if (pan is not null && acesas.Count > 0)
        {
            foreach (var (slug, g) in acesas) acendem[slug] = Gravidades.Pontos(g);
            saudeSobe = novo.Resumo.SaudePct > (saudeAnterior ?? novo.Resumo.SaudePct);
            var nomes = string.Join(", ", acesas.Select(x => System.Net.WebUtility.HtmlEncode(novo.Estrelas.First(e => e.Slug == x.Slug).Nome)));
            /* sem placar (fontes reais, ainda sem a rota de pontos), o toast não fala em pontos */
            var pontos = novo.Placar.GestoresNoSquad > 0 ? $" · <em>+{acesas.Sum(x => Gravidades.Pontos(x.G))} pts</em>" : "";
            AvisarHtml($"<b>{nomes}</b> acendeu verde{pontos} · em instantes desliza pra órbita de fora", neutro: false, segundos: 6);
            _ = Task.Delay(3200).ContinueWith(_ => InvokeAsync(() => { acendem.Clear(); saudeSobe = false; StateHasChanged(); }));
        }
        saudeAnterior = novo.Resumo.SaudePct;
        pan = novo;
    }

    string EstiloDa(Estrela e)
    {
        var f = Orbita.Fator(e.Posicao.Anel) - (e.Posicao.Volta > 0 ? .03 : 0);
        return $"--a:{e.Posicao.Angulo.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}deg;--r:calc(var(--mapa) * {f.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)})";
    }

    string ChipDa(Estrela e)
    {
        var rad = e.Posicao.Angulo * Math.PI / 180;
        var f = Orbita.Fator(e.Posicao.Anel);
        var cx = (Math.Cos(rad) * f).ToString("0.000", System.Globalization.CultureInfo.InvariantCulture);
        var cy = (Math.Sin(rad) * f).ToString("0.000", System.Globalization.CultureInfo.InvariantCulture);
        return $"left:calc(50% + var(--mapa) * {cx});top:calc(50% + var(--mapa) * {cy} - 26px)";
    }

    static string Curto(long centavos)
    {
        var reais = centavos / 100.0;
        return reais >= 10_000 ? "R$ " + (reais / 1000).ToString("0.#", Pt) + "k" : Dinheiro.ReaisCurto(centavos);
    }
    static int Pct(long parte, long todo) => todo <= 0 ? 0 : (int)Math.Clamp(Math.Round(parte * 100.0 / todo), 0, 100);

    void Abrir(Estrela e) { Painel.Foco = Painel.Foco == e.Slug ? null : e.Slug; Painel.Avisar(); }
    void FecharPopover() { if (Painel.Foco is not null) { Painel.Foco = null; Painel.Avisar(); } }
    void Tecla(KeyboardEventArgs k, Estrela e) { if (k.Key is "Enter" or " ") Abrir(e); }

    /// <summary>"LogTech Frotas, gravidade 1, automação parou, parou ontem 07:30 · token vencido" (o leitor de tela lê o mapa assim).</summary>
    static string RotuloDaEstrela(Estrela e) => e.Principal is { } a
        ? $"{e.Nome}, gravidade {(int)a.Gravidade}, {Gravidades.Rotulo(a.Gravidade)}, {a.Curto}{(e.EstaVista ? ", visto" : "")}"
        : $"{e.Nome}, em dia{(e.DecisoesPendentes > 0 ? $", {e.DecisoesPendentes} decisão(ões) do agente esperando você" : "")}";

    /// <summary>Texto puro (vem do aprofundamento e pode ter o nome do cliente): codificado antes de virar HTML.</summary>
    Task Avisar(string texto) => AvisarHtml(System.Net.WebUtility.HtmlEncode(texto), neutro: true, segundos: 4);
    Task AvisarHtml(string html, bool neutro, int segundos)
    {
        var texto = html;
        toastCts?.Cancel(); toastCts = new();
        toast = texto; toastNeutro = neutro;
        var ct = toastCts.Token;
        _ = Task.Delay(TimeSpan.FromSeconds(segundos), ct).ContinueWith(t => { if (!t.IsCanceled) InvokeAsync(() => { toast = null; StateHasChanged(); }); });
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose() { Painel.Mudou -= Mudou; toastCts?.Cancel(); }
}
